# Data & DB
data/*.csv
data/*.duckdb
data/*.parquet
!data/.gitkeep
# Exceptions: these two are deliberately committed for the public cloud
# deployment (Streamlit Community Cloud has no persistent volume, so the
# app needs its data baked into the repo). Both are well under GitHub's
# 100MB limit — see scripts/build_demo_db.py for how the demo DB is built.
!data/features_train.parquet
!data/credit_risk_demo.duckdb

# Model artifacts — the trained model IS committed (small, ~3MB, and is an
# explicit deliverable per the assignment: "saved model artifacts"). Other
# pkl/joblib files (e.g. future experiment checkpoints) stay ignored.
models/*.pkl
!models/lgbm_model.pkl
models/*.joblib
!models/.gitkeep

# Env
.env
.streamlit/secrets.toml
venv/
.venv/
__pycache__/
*.pyc
node_modules/

# Notebook checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
