# --- LLM Provider (Talk-to-Data chatbot) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# openai/gpt-oss-120b is a reasoning model — the talk-to-data code automatically
# passes reasoning_effort="low" for any model name containing "gpt-oss" to keep
# its internal reasoning pass from consuming the whole token budget on hard
# questions. Swap to a non-reasoning model if you'd rather skip that behavior.
GROQ_MODEL=openai/gpt-oss-120b

# --- Database ---
# Path to the DuckDB file built from the Home Credit CSVs (auto-created by src/data/loader.py)
DB_PATH=./data/credit_risk.duckdb

# --- App Config ---
APP_ENV=production
LOG_LEVEL=INFO
RISK_LOW_THRESHOLD=0.10
RISK_HIGH_THRESHOLD=0.35

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
