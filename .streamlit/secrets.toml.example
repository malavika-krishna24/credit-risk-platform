# Streamlit Community Cloud secrets template
#
# This file is NOT read automatically — it's documentation for what to paste
# into the Streamlit Community Cloud dashboard under:
#   Your app -> Settings -> Secrets
#
# Copy the lines below (with your real key) into that box. Do NOT commit a
# real secrets.toml to git — this .example file is the only one that should
# ever be tracked.

GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"

# Points the deployed app at the size-reduced demo database (see
# scripts/build_demo_db.py) instead of the full local one, since Streamlit
# Community Cloud has no persistent volume for a multi-hundred-MB file.
DB_PATH = "data/credit_risk_demo.duckdb"

RISK_LOW_THRESHOLD = "0.10"
RISK_HIGH_THRESHOLD = "0.35"
